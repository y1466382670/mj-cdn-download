PORT=8080
DATA_DIR=data

# Your CDN prefix. No trailing slash.
# With only this set, files stay local and url is the prefix plus the storage key.
# If the hostname origins to /files/ on this service, use https://img.example.com/files
# CDN_BASE_URL=https://img.example.com

# local keeps files on this machine. Set s3 for R2 or another object store.
STORAGE=local

# Cloudflare R2. All four S3 fields are required. Put the public hostname in CDN_BASE_URL.
# STORAGE=s3
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=your-bucket
# S3_ACCESS_KEY=your-access-key
# S3_SECRET_KEY=your-secret-key
# S3_PATH_STYLE=true
# CDN_BASE_URL=https://img.example.com

TIMEOUT_SECONDS=30
BUDGET_SECONDS=90
MAX_RETRY=3
MAX_INFLIGHT=32
SOLVE=true
HEADLESS=new
CHROME_BIN=
